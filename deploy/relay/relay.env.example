# Rokn enquiry relay - environment template (variable NAMES; secrets left blank).
# Copy to /opt/rokn-relay/relay.env on the VM, chmod 600. NEVER commit the real file.

# Company OS website-lead intake, reached over the private compose network.
COMPANY_OS_INTAKE_URL=http://app:8000/api/v1/leads/website

# SECRET. Same value as WEBSITE_WEBHOOK_SECRET in Company OS's .env.production.
# Filled in on the VM by a server-side copy (see README); never typed, pasted or printed.
COMPANY_OS_WEBHOOK_SECRET=

# Only these browser origins may submit. Remove the www entry if the site never serves it.
ALLOWED_ORIGINS=https://roknalahlam.com,https://www.roknalahlam.com

# Caddy is the only proxy and overwrites X-Forwarded-For, so trusting it is safe.
TRUST_PROXY=1

# Requests per minute per visitor IP, and how long to wait for Company OS.
RATE_LIMIT_PER_MIN=10
UPSTREAM_TIMEOUT_MS=8000
